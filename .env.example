# Copy to .env.local. Never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.

# Browser origin for POST request verification. Use the deployed origin in production.
APP_ORIGIN=http://localhost:3000

# Internal authentication identifiers, never shown to users or used to send email.
AUTH_LOGIN_DOMAIN=auth.classdashboard.invalid
